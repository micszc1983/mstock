[Unit]
Description=MStock Frontend (Vite dev server)
After=network.target mstock-backend.service
Wants=mstock-backend.service

[Service]
Type=simple
User=tt38dn
Group=tt38dn
WorkingDirectory=/home/tt38dn/MStock/frontend

ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mstock-frontend

[Install]
WantedBy=multi-user.target