# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Bazy danych ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# Warianty bazy (kopie zapasowe, eksporty, naprawy)
*.db.*
backend/backups/
*.dump

# ── Sekrety i konfiguracja lokalna ────────────────────────────────────────────
.env
# .env.example — NIE ignoruj, zawiera dokumentację zmiennych bez sekretów

# ── ML modele (generowane automatycznie przez backend) ────────────────────────
backend/ml_models/
# Jeśli chcesz śledzić modele — usuń powyższą linię

# ── Logi ─────────────────────────────────────────────────────────────────────
*.log
backend.log
frontend.log
.run/

# ── Raporty generowane ────────────────────────────────────────────────────────
backend/generated_reports/

# ── Node.js ───────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# ── Testy i narzędzia ─────────────────────────────────────────────────────────
.pytest_cache/
backend/.pytest_release_tmp/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Systemy operacyjne ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
# Claude Code — ustawienia lokalne (specyficzne dla maszyny, nie dla repo)
.claude/

# ── Pliki runtime ─────────────────────────────────────────────────────────────
*.pid
backend.pid
frontend.pid
