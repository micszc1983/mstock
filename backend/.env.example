# ============================================================
#  ThesisLab — pełna konfiguracja środowiska
#  Skopiuj jako .env i uzupełnij wartości
# ============================================================


# ── Baza danych ─────────────────────────────────────────────
# SQLite (domyślnie, zero konfiguracji):
DATABASE_URL=sqlite:///./thesislab.db
# PostgreSQL (produkcja):
# Lokalne połączenie przez Unix socket i uwierzytelnienie peer:
# DATABASE_URL=postgresql+psycopg:///mstock
# Połączenie TCP:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mstock

# Wymagany dla zdalnych operacji /admin i mutujących operacji /ml.
# Użyj długiego losowego sekretu; tę samą wartość ustaw jako VITE_ADMIN_API_KEY.
ADMIN_API_KEY=


# ── Klucze API providerów danych ────────────────────────────
# Alpha Vantage — ceny akcji, metale, newsy
# Darmowy plan: 25 req/dzień. Premium: 75+/min
# Rejestracja: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Finnhub — newsy spółek (company-news endpoint)
# Darmowy plan: 60 req/min
# Rejestracja: https://finnhub.io/register
FINNHUB_API_KEY=

# Massive.com — US stocks, 2 lata historii, 50 000 punktów / call
# Priorytetowy provider cen dla US stocks (priorytet 1 z 5)
# Rejestracja: https://massive.com/
MASSIVE_API_KEY=

# Twelve Data — US stocks, ~20 lat historii, 5 000 punktów / call
# Fallback gdy Massive niedostępny (priorytet 2 z 5); 800 req/dzień (plan basic)
# Rejestracja: https://twelvedata.com/
TWELVEDATA_API_KEY=

# EODHD — główne źródło dziennych OHLCV dla GPW (ticker CODE.WAR)
# Bez klucza aplikacja automatycznie używa bezpłatnego Yahoo jako fallbacku.
# Rejestracja: https://eodhd.com/register
EODHD_API_KEY=

# Płatne fallbacki RapidAPI są domyślnie wyłączone, aby błędna subskrypcja
# nie generowała cyklicznych 403/429 i nie zużywała limitu.
RAPIDAPI_PRICE_FALLBACK_ENABLED=false

# Alpha Vantage ma wspólny niski limit dla cen i newsów. Domyślnie nie jest
# uruchamiane jako newsowy fallback po pustym RSS/NewsAPI.
ALPHAVANTAGE_NEWS_FALLBACK_ENABLED=false

# Maksymalna mediana różnicy close EODHD ↔ Yahoo na wspólnych sesjach.
GPW_PRICE_CROSSCHECK_TOLERANCE_PCT=2.0

# Timeout dla requestów do providerów (sekundy)
SYNC_TIMEOUT_SECONDS=20


# ── Scheduler — harmonogram automatyzacji ───────────────────
# Włącz/wyłącz automatyczny cykl pipeline'u
AUTO_SYNC_ENABLED=true

# Jak często uruchamiać pełny cykl (minuty)
# Zalecane: 60 (1h) dla darmowych kluczy API
# Darmowy Alpha Vantage: max ~25 req/dzień → min ~60 min
AUTO_SYNC_INTERVAL_MINUTES=60

# Automatyczna rekalibracja rekomendacji. Scheduler sprawdza ją raz dziennie,
# ale uruchamia kosztowny audyt dopiero po upływie interwału i zebraniu nowych
# rozliczonych próbek 5d.
RECOMMENDATION_AUDIT_AUTO_ENABLED=true
RECOMMENDATION_AUDIT_INTERVAL_DAYS=7
RECOMMENDATION_AUDIT_MIN_NEW_OUTCOMES=50
RECOMMENDATION_AUDIT_FOLDS=3

# Automatyczne generowanie raportów PDF co cykl
# Włącz jeśli chcesz mieć archiwum PDF po każdym cyklu
REPORTS_AUTO_ENABLED=false

# Automatyczna wysyłka powiadomień o alertach (email/WhatsApp)
# Wymaga skonfigurowania SMTP lub Twilio poniżej
NOTIFICATIONS_AUTO_ENABLED=false

# Automatyczne retrenowanie modeli ML po każdym builddzie datasetu
# Wyłącz jeśli trening zajmuje za dużo czasu na Twoim sprzęcie
ML_RETRAIN_AUTO_ENABLED=true
ML_RETRAIN_INTERVAL_HOURS=24
ML_RETRAIN_MIN_NEW_ROWS=20
ML_PREDICTION_RETENTION_DAYS=365
ML_MODEL_RUN_RETENTION_COUNT=15

# Operacja destrukcyjna przeznaczona wyłącznie do świadomego czyszczenia danych demo.
ALLOW_SEED_CLEANUP=false

# Ciężki rebuild/backfill przy starcie blokuje healthcheck i może odpalać wiele
# zapytań do providerów. Domyślnie robi to scheduler już po uruchomieniu API.
STARTUP_REBUILD_ENABLED=false

# Kalibracja rekomendacji. Koszt oznacza pełny round-trip w % wartości pozycji
# (prowizje + spread + poślizg). Progi KUP/SPRZEDAJ są uczone osobno.
RECOMMENDATION_COST_USA_PCT=0.20
RECOMMENDATION_COST_GPW_PCT=0.40
RECOMMENDATION_COST_OTHER_PCT=0.35
RECOMMENDATION_CALIBRATION_MIN_ROWS=80
RECOMMENDATION_CALIBRATION_MAX_ROWS=6000
RECOMMENDATION_CALIBRATION_PURGE_SESSIONS=5
RECOMMENDATION_CALIBRATION_MIN_TRAIN_SESSIONS=60
RECOMMENDATION_FORECAST_CONSENSUS_VETO_PROBABILITY=0.45
PAPER_ENTRY_CONFIRMATION_CYCLES=2
PAPER_REQUIRE_CLOSED_SESSION_ENTRY=true

# Etykiety triple-barrier i meta-labeling. Bariery są skalowane trailing volatility,
# a meta-model dopuszcza transakcję dopiero od podanego P(opłacalna transakcja).
TRIPLE_BARRIER_HORIZON_SESSIONS=10
TRIPLE_BARRIER_TAKE_PROFIT_VOL_MULTIPLIER=1.25
TRIPLE_BARRIER_STOP_LOSS_VOL_MULTIPLIER=0.90
META_TRADE_PROBABILITY_THRESHOLD=0.55

# Bezpieczna promocja challengerów na nietkniętym holdoucie po kosztach.
CHALLENGER_MIN_HOLDOUT_TRADES=20
CHALLENGER_MIN_UTILITY_GAIN=0.05
ML_CALIBRATION_FRACTION=0.15
ML_MARKET_MODELS_ENABLED=true
ML_CPCV_ENABLED=true
ML_PBO_MAX=0.55
ML_MONITORING_ENABLED=true
ML_DRIFT_PSI_WARNING=0.20
ML_DRIFT_PSI_CRITICAL=0.35
ML_MONITOR_MIN_OUTCOMES=20


# ── NLP Backend ──────────────────────────────────────────────
# auto        — wykrywa automatycznie: transformer jeśli zainstalowany, else heuristic
# heuristic   — keyword-based (szybki, zero dodatkowych zależności, domyślny)
# transformer — FinBERT + sentence-transformers (wyższa jakość, wymaga GPU/RAM)
#
# Aby włączyć transformer:
#   pip install transformers torch sentence-transformers
#   Modele (~520 MB) pobiorą się automatycznie przy pierwszym użyciu
NLP_BACKEND=auto


# ── CORS (frontend) ──────────────────────────────────────────
# Adresy frontendu — rozdzielone przecinkiem
# Dodaj domenę produkcyjną jeśli deploywujesz na serwer
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://devserver:5173,http://100.88.38.115:5173,http://devserver.example-tailnet.ts.net:5173,https://devserver.example-tailnet.ts.net


# ── Email (SMTP) ──────────────────────────────────────────────
# Wymagane dla NOTIFICATIONS_AUTO_ENABLED=true i ręcznych notyfikacji
# Przykład dla Gmail: smtp.gmail.com:587, użyj App Password
# Przykład dla Mailgun: smtp.mailgun.org:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=


# ── WhatsApp (Twilio) ─────────────────────────────────────────
# Wymagane dla powiadomień WhatsApp
# Rejestracja: https://www.twilio.com/whatsapp
# Format numeru: whatsapp:+48XXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ── Raporty PDF ───────────────────────────────────────────────
# Katalog gdzie zapisywane są generowane raporty PDF
REPORTS_DIR=./generated_reports


# ── ML Foundation ─────────────────────────────────────────────
# Aktywacja ML jest automatyczna per model. UI udostępnia tylko awaryjny kill switch.
# Zachowane dla kompatybilności starszych wdrożeń; nie wymusza użycia modelu.
ML_ENABLED_DEFAULT=false

# Katalog dla zapisanych modeli (.joblib)
ML_MODELS_DIR=./ml_models

# Minimalna liczba labeled rows wymagana do treningu modelu
# Niższe = szybciej model gotowy, ale gorzej wytrenowany
# Zalecane: 60-200 zależnie od liczby aktywów i historii
ML_MIN_TRAINING_ROWS=120
